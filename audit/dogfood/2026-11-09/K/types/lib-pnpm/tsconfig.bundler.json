{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "out/bundler"
  },
  "include": ["src"]
}
