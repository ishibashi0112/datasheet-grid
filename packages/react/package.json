{
  "name": "@ishibashi0112/spreadsheet-grid",
  "version": "0.38.0",
  "description": "React 19 製のカスタム仮想化データグリッド。100 万行対応の仮想化・3 ペイン固定列・ソート/フィルター・クライアント/サーバーサイド行モデル対応。コアは @ishibashi0112/spreadsheet-grid-core。",
  "keywords": [
    "react",
    "react19",
    "grid",
    "datagrid",
    "table",
    "spreadsheet",
    "virtualized",
    "virtual-scroll",
    "typescript",
    "ssrm"
  ],
  "license": "MIT",
  "author": "Yuki Sakakibara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishibashi0112/datasheet-grid.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ishibashi0112/datasheet-grid#readme",
  "bugs": {
    "url": "https://github.com/ishibashi0112/datasheet-grid/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./style.css": "./dist/style.css",
    "./style.layer.css": "./dist/style.layer.css"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "vp build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/emit-layer-css.mjs",
    "build:types": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ishibashi0112/spreadsheet-grid-core": "workspace:^",
    "@tanstack/virtual-core": "^3.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}